# WCTNG Docker Development Environment
# Copy this file to .env and customize as needed.

# MySQL Configuration
MYSQL_ROOT_PASSWORD=wctng_root_secret
MYSQL_DATABASE=webcalendar
MYSQL_USER=webcalendar
MYSQL_PASSWORD=webcalendar_dev

# Application
APP_ENV=dev
APP_SECRET=change_me_in_production_abcdef1234567890

# JWT (generate keys with: openssl genrsa -out config/jwt/private.pem 4096 && openssl rsa -pubout -in config/jwt/private.pem -out config/jwt/public.pem)
JWT_PASSPHRASE=wctng_jwt_dev_passphrase
JWT_TTL=3600

# CORS
CORS_ALLOW_ORIGIN=http://localhost:47173

# Ports (high ports to avoid conflicts)
PORT_NGINX=47180
PORT_MYSQL=47106
PORT_VITE=47173
