# Committed defaults for environments that have no .env of their own.
#
# Symfony's Dotenv::loadEnv() falls back to this file when .env is absent,
# which is the case in any fresh checkout: .env is gitignored, so without
# this both bin/console and tests/bootstrap.php die with
# "Unable to read the ... .env environment file" before doing any work.
#
# Non-secret defaults only. Real deployments override these with real
# environment variables (docker-compose passes them; CI sets them per step),
# and those always win over anything set here. Copy to .env for local use.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_production_abcdef1234567890
APP_MODE=standalone

DATABASE_URL="mysql://webcalendar:webcalendar_dev@127.0.0.1:3306/webcalendar"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_production
JWT_TTL=3600

CORS_ALLOW_ORIGIN=http://localhost:47173
DEFAULT_URI=http://localhost

MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:47181/.well-known/mercure
MERCURE_JWT_SECRET=change_me_in_production_32_chars_

TENANT_BASE_DOMAIN=webcalendar.local
TENANT_DB_DRIVER=sqlite

# Hosted mode with TENANT_DB_DRIVER=mysql only. Provisioning a tenant needs
# CREATE DATABASE and CREATE USER, which the application login in
# DATABASE_URL deliberately does not have. Same URL form as DATABASE_URL;
# left empty, provisioning reports that it is not configured.
TENANT_ADMIN_DATABASE_URL=

REDIS_URL=
CONTROL_WEBHOOK_URL=

MAILER_DSN=null://null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=WebCalendar
