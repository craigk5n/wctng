{
    "name": "craigk5n/webcalendar-api",
    "description": "WebCalendar Next Generation — Symfony REST API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "craigk5n/webcalendar-core": "^4.1",
        "lexik/jwt-authentication-bundle": "^3.1",
        "nelmio/cors-bundle": "^2.4",
        "sabre/dav": "^4.7",
        "symfony/clock": "^7.4",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^7.2",
        "symfony/html-sanitizer": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/translation": "^7.4",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "^7.2",
        "symfony/css-selector": "^7.2",
        "symfony/phpunit-bridge": "^7.2",
        "vimeo/psalm": "^6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/craigk5n/webcalendar-core.git"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.30"
        },
        "platform-check": false,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "check-sensitive-params": "php bin/check-sensitive-params.php",
        "check-clock-injection": "php bin/check-clock-injection.php"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    }
}
